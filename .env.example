# === IDENTIFIANTS DE L'APPLICATION ===
# ID unique de l'application
VITE_APP_ID=andaloussi-coaching-dev

# === SÉCURITÉ ===
# JWT Secret : DOIT contenir au moins 32 caractères
# Générer avec : openssl rand -base64 32
JWT_SECRET=changez_cette_clé_par_une_vraie_clé_secrète_64_caractères_minimum

# === BASE DE DONNÉES ===
# URL de connexion MySQL
# Format : mysql://utilisateur:motdepasse@host:port/nom_base
DATABASE_URL=mysql://root:password@localhost:3307/andaloussi_coaching

# === OAUTH MANUS ===
# URL du serveur OAuth Manus
OAUTH_SERVER_URL=https://oauth.manus.im

# Open ID du propriétaire (coach)
OWNER_OPEN_ID=votre_open_id_manus

# === CONFIGURATION FRONTEND ===
# URL du frontend (pour CSP et CORS)
# En développement : http://localhost:5173
# En production : https://votre-domaine.com
FRONTEND_URL=http://localhost:5173

# === ENVIRONNEMENT ===
# development | production | test
NODE_ENV=development

# === SENTRY (Error Tracking) ===
# DSN Sentry pour le tracking des erreurs
# Créer un projet sur https://sentry.io pour obtenir le DSN
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Version de release (facultatif)
VITE_RELEASE_VERSION=1.0.0

# === API FORGE (OPTIONNEL) ===
# URL de l'API Forge Manus
BUILT_IN_FORGE_API_URL=https://forge-api.manus.im
# Clé API Forge
BUILT_IN_FORGE_API_KEY=votre_clé_api_forge

# === STRIPE PAIEMENT ===
# Clé secrète Stripe (commence par sk_test_ ou sk_live_)
STRIPE_SECRET_KEY=sk_test_votre_clé_secrète_ici
# Clé publique Stripe (commence par pk_test_ ou pk_live_) - pour le frontend si nécessaire
VITE_STRIPE_PUBLIC_KEY=pk_test_votre_clé_publique_ici
# Secret du webhook Stripe (pour vérifier les signatures)
STRIPE_WEBHOOK_SECRET=whsec_votre_webhook_secret_ici
